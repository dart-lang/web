import 'package:web/web.dart';

late WebGLContextEvent $contextEvent;
late WebGLRenderingContext $webGL;

final HTMLAudioElement $audio = HTMLAudioElement();
final HTMLIFrameElement $iframe = HTMLIFrameElement();
final HTMLCanvasElement $canvas0 = HTMLCanvasElement();

late TouchList $touchList;
late JSImmutableListWrapper<TouchList, Touch> $touchListWrapper;
final $touchListInit = JSImmutableListWrapper<TouchList, Touch>($touchList);

Node testExtensions(
  CanvasRenderingContext2D ctx2d,
  HTMLImageElement img,
  Node node,
  Node child,
  HTMLDivElement div,
) {
  ctx2d.drawImage(img, 0, 0, 10, 10);
  node.textContent = 'hello';
  div.textContent = 'world';
  div.parentNode!.textContent = 'chained';
  div.append(child);
  return node.appendChild(child);
}

late JSArray<JSNumber> $uvmEntry;
late JSArray<JSArray<JSNumber>>? $uvmEntries;

// CSSStyleDeclaration & CSSStyleProperties 1:1 property renames
void testCssStyleRenames(
  CSSStyleDeclaration style,
  HTMLElement element,
  Window win,
) {
  style.borderTopClip = style.borderTopClip;
  style.borderRightClip = style.borderRightClip;
  style.borderBottomClip = style.borderBottomClip;
  style.borderLeftClip = style.borderLeftClip;
  style.corner = style.corner;
  style.positionArea = style.positionArea;
  style.positionTryFallbacks = style.positionTryFallbacks;
  style.textDecorationInset = style.textDecorationInset;
  style.scrollInitialTarget = style.scrollInitialTarget;

  // Chained PropertyAccess & cascade on CSSStyleProperties (`element.style` /
  // `getComputedStyle`)
  element.style.borderTopClip = element.style.borderTopClip;
  element.style.borderRightClip = element.style.borderRightClip;
  element.style.borderBottomClip = element.style.borderBottomClip;
  element.style.borderLeftClip = element.style.borderLeftClip;
  element.style.corner = win.getComputedStyle(element).corner;
  element.style
    ..positionArea = element.style.positionArea
    ..positionTryFallbacks = element.style.positionTryFallbacks
    ..textDecorationInset = element.style.textDecorationInset
    ..scrollInitialTarget = element.style.scrollInitialTarget;
}
